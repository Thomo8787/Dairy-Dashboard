# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=false

# First admin account (seeded only when the users table is empty)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# PostgreSQL (Render provides DATABASE_URL automatically on the web service)
DATABASE_URL=postgresql://user:password@localhost:5432/dairy_dashboard

# Microsoft Graph / Azure AD app registration (Farm Dashboard)
# Put real values in Render Environment — never commit secrets.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# application = admin-consented app access (recommended for parlours@alhfarm.com OneDrive)
# delegated = user signs in via Connect Microsoft 365
GRAPH_AUTH_MODE=application

# Only needed for GRAPH_AUTH_MODE=delegated
AZURE_REDIRECT_URI=

# Inbox that receives dairy emails (can be parlours@alhfarm.com or another mailbox)
OUTLOOK_MAILBOX=parlours@alhfarm.com

# Optional: only process emails from this sender (substring match)
OUTLOOK_SENDER_FILTER=

# Optional: subject line must contain this text
OUTLOOK_SUBJECT_FILTER=

# OneDrive owner account (used if ONEDRIVE_SHARE_URL is blank)
ONEDRIVE_USER=parlours@alhfarm.com

# Preferred: paste a folder sharing link (parent folder that may contain subfolders)
ONEDRIVE_SHARE_URL=

# Alternative to share URL: folder path under that OneDrive (blank = entire drive root)
ONEDRIVE_FOLDER_PATH=

# Optional: only import Excel names containing these fragments (comma-separated)
# Example: dairy,yield,weekly
ONEDRIVE_FILENAME_FILTER=

# Safety cap when scanning many nested folders
ONEDRIVE_MAX_FILES=100

# Optional: local synced OneDrive folder for DCEXPORT* (desktop, no Graph required)
# LOCAL_HERD_EXPORT_DIR=C:\Users\you\OneDrive\Parlours
