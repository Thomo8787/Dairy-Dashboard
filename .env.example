# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=false

# PostgreSQL (Render provides DATABASE_URL automatically on the web service)
# Use Render's Internal Database URL when deploying — see DEPLOY.md
DATABASE_URL=postgresql://user:password@localhost:5432/dairy_dashboard

# Microsoft Graph / Azure AD app registration
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Mailbox to read (user principal name or shared mailbox)
OUTLOOK_MAILBOX=

# Optional: only process emails from this sender
OUTLOOK_SENDER_FILTER=

# Optional: subject line must contain this text
OUTLOOK_SUBJECT_FILTER=

# OneDrive (work/school account email that owns the drive)
ONEDRIVE_USER=

# Optional folder path under that user's OneDrive (leave blank for root)
# Examples: Dairy Reports   or   Documents/Dairy Reports
ONEDRIVE_FOLDER_PATH=
